{
  "name": "a2b-native",
  "version": "0.1.0",
  "private": true,
  "description": "A2B as an Android app: a Capacitor shell around the live web app, with native GPS, voice and keep-awake.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
