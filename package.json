{
  "name": "a2b",
  "version": "0.1.0",
  "private": true,
  "description": "Community-powered driving navigation in the browser: live routes, turn-by-turn voice, and road reports from other drivers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply a2b --local",
    "db:migrate:remote": "wrangler d1 migrations apply a2b --remote",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
